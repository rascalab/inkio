    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "ws": "^8.18.0",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.7.0",
    "@types/node": "^25.5.2",
    "@types/ws": "^8.18.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=22"
