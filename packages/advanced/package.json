{
  "name": "@inkio/advanced",
  "version": "0.0.7",
  "description": "Advanced notion-like and integration-aware extensions for Inkio",
  "license": "MIT",
  "homepage": "https://rascalab.github.io/inkio/",
  "bugs": {
    "url": "https://github.com/rascalab/inkio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rascalab/inkio.git",
    "directory": "packages/advanced"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./block-handle": {
      "import": {
        "types": "./dist/block-handle.d.ts",
        "default": "./dist/block-handle.js"
      },
      "require": {
        "types": "./dist/block-handle.d.cts",
        "default": "./dist/block-handle.cjs"
      }
    },
    "./bookmark": {
      "import": {
        "types": "./dist/bookmark.d.ts",
        "default": "./dist/bookmark.js"
      },
      "require": {
        "types": "./dist/bookmark.d.cts",
        "default": "./dist/bookmark.cjs"
      }
    },
    "./mention": {
      "import": {
        "types": "./dist/mention.d.ts",
        "default": "./dist/mention.js"
      },
      "require": {
        "types": "./dist/mention.d.cts",
        "default": "./dist/mention.cjs"
      }
    },
    "./hashtag": {
      "import": {
        "types": "./dist/hashtag.d.ts",
        "default": "./dist/hashtag.js"
      },
      "require": {
        "types": "./dist/hashtag.d.cts",
        "default": "./dist/hashtag.cjs"
      }
    },
    "./slash-command": {
      "import": {
        "types": "./dist/slash-command.d.ts",
        "default": "./dist/slash-command.js"
      },
      "require": {
        "types": "./dist/slash-command.d.cts",
        "default": "./dist/slash-command.cjs"
      }
    },
    "./wikilink": {
      "import": {
        "types": "./dist/wikilink.d.ts",
        "default": "./dist/wikilink.js"
      },
      "require": {
        "types": "./dist/wikilink.d.cts",
        "default": "./dist/wikilink.cjs"
      }
    },
    "./comment": {
      "import": {
        "types": "./dist/comment.d.ts",
        "default": "./dist/comment.js"
      },
      "require": {
        "types": "./dist/comment.d.cts",
        "default": "./dist/comment.cjs"
      }
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "bundle:smoke": "INKIO_VITE_SKIP_DTS=1 node ../../scripts/run-vite-package-build.mjs",
    "bundle": "node ../../scripts/run-vite-package-build.mjs",
    "build": "pnpm typecheck && pnpm bundle",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@inkio/core": "workspace:^",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tiptap/extension-document": "^3.31.4",
    "@tiptap/extension-paragraph": "^3.31.4",
    "@tiptap/extension-text": "^3.31.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
