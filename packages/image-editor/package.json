{
  "name": "@inkio/image-editor",
  "version": "0.0.7",
  "description": "Image editor UI for Inkio image blocks",
  "license": "MIT",
  "homepage": "https://rascalab.github.io/inkio/",
  "bugs": {
    "url": "https://github.com/rascalab/inkio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rascalab/inkio.git",
    "directory": "packages/image-editor"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "bundle:smoke": "INKIO_VITE_SKIP_DTS=1 node ../../scripts/run-vite-package-build.mjs",
    "bundle": "node ../../scripts/run-vite-package-build.mjs",
    "build": "pnpm typecheck && pnpm bundle",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@inkio/core": "workspace:^",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "konva": "^10.7.0",
    "react-konva": "^19.3.0"
  },
  "devDependencies": {
    "@inkio/core": "workspace:^",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
